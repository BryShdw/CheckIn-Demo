# Plantilla de Configuración de Entorno - Sistema de Check-in DACER
# Copia este archivo a '.env' y ajusta las credenciales de tu base de datos MySQL local

SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-en-produccion

# Base de Datos MySQL (Instalada en la Mini PC NUC)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=checkin_dacer_db

# Hardware y Kiosko
PRINTER_NAME=Brother QL-800
PRINTER_MODEL=QL-800
LABEL_TYPE=38x90
DEFAULT_EVENT_NAME=EVENTO DEMO 2026
FACE_THRESHOLD=0.55
